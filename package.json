{
	"name": "hire-hub",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
		"start": "NODE_ENV=development nest build --webpack --webpackPath webpack-hmr.config.js --watch",
		"start:dev": "NODE_ENV=development nest start --watch",
		"start:dev:batch": "NODE_ENV=development nest start hirehub-batch --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/apps/hire-hub/main",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./apps/hire-hub/test/jest-e2e.json"
	},
	"dependencies": {
		"@apollo/server": "^4.9.5",
		"@aws-sdk/client-s3": "^3.962.0",
		"@nestjs/apollo": "^12.0.10",
		"@nestjs/axios": "^3.0.1",
		"@nestjs/common": "^10.0.0",
		"@nestjs/config": "^3.3.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/graphql": "^12.0.10",
		"@nestjs/jwt": "^10.2.0",
		"@nestjs/mongoose": "^10.0.2",
		"@nestjs/passport": "^10.0.3",
		"@nestjs/platform-express": "^10.4.22",
		"@nestjs/platform-socket.io": "^10.2.10",
		"@nestjs/platform-ws": "^10.2.10",
		"@nestjs/schedule": "^4.0.0",
		"@nestjs/terminus": "^10.2.3",
		"@nestjs/websockets": "^10.2.10",
		"@types/geoip-lite": "^1.4.4",
		"@types/multer": "^2.0.0",
		"@types/qrcode": "^1.5.6",
		"@types/speakeasy": "^2.0.10",
		"bcryptjs": "^2.4.3",
		"chalk": "^5.6.2",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.0",
		"D": "^1.0.0",
		"graphql": "^16.8.1",
		"graphql-upload": "^13.0.0",
		"hbs": "^4.2.0",
		"moment": "^2.29.4",
		"mongoose": "^8.0.0",
		"nodemailer": "^7.0.12",
		"passport": "^0.7.0",
		"passport-github2": "^0.1.12",
		"passport-google-oauth20": "^2.0.0",
		"passport-linkedin-oauth2": "^2.0.0",
		"qrcode": "^1.5.4",
		"reflect-metadata": "^0.1.13",
